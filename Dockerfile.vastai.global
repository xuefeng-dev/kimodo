FROM nvcr.io/nvidia/pytorch:24.10-py3

# Avoid some interactive prompts + make pip quieter/reproducible-ish
ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_ENDPOINT=https://huggingface.co \
    HF_HOME=/workspace/.cache/huggingface \
    HUGGINGFACE_CACHE_DIR=/workspace/.cache/huggingface \
    TEXT_ENCODERS_DIR=/workspace/text_encoders \
    CHECKPOINT_DIR=/workspace/checkpoints \
    LOCAL_CACHE=True

WORKDIR /workspace

# ── 稳定层：系统依赖 ──────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
      git curl ca-certificates \
      cmake build-essential \
      gosu \
    && rm -rf /var/lib/apt/lists/*

# 基础镜像里可能有一个坏的 cmake shim，删掉它以免 MotionCorrection 构建失败
RUN rm -f /usr/local/bin/cmake || true

# ── 稳定层：第三方 viser fork（变更频率低）────────────────────────────────────
RUN git clone https://github.com/nv-tlabs/kimodo-viser.git /workspace/kimodo-viser

# ── 稳定层：仅复制依赖清单，安装 PyPI 第三方包（不含本地 -e 包）────────────
COPY docker_requirements.txt /workspace/docker_requirements.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --upgrade pip \
 && awk '!/^(-e |\.|#|[[:space:]])/' /workspace/docker_requirements.txt \
      > /tmp/docker_requirements_deps.txt \
 && python -m pip install -r /tmp/docker_requirements_deps.txt

# ── 中频变更层：MotionCorrection + viser 本地包 ───────────────────────────────
COPY setup.py /workspace/setup.py
COPY pyproject.toml /workspace/pyproject.toml
COPY MotionCorrection /workspace/MotionCorrection

RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install ./MotionCorrection \
 && python -m pip install -e ./kimodo-viser

# 预构建 Viser 前端，避免实例首次启动时现场 npm install/build（需数分钟）
RUN python -m viser._client_autobuild

# ── 稳定层：预下载模型（体积大、几乎不变）────────────────────────────────────
# 构建时传入：
#   docker build --build-context model_cache=/root/dev/kimodo_model_cache ...
COPY --from=model_cache /checkpoints /workspace/checkpoints
COPY --from=model_cache /text_encoders /workspace/text_encoders
COPY --from=model_cache /huggingface /workspace/.cache/huggingface

# ── 高频变更层：kimodo 源码（editable install，依赖已在上方装好）──────────────
COPY kimodo /workspace/kimodo

RUN --mount=type=cache,target=/root/.cache/pip \
    SKIP_MOTION_CORRECTION_IN_SETUP=1 python -m pip install --no-deps -e .

# ── 高频变更层：启动脚本（放最后，改脚本不触发上方重装）──────────────────────
COPY kimodo/scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint
COPY scripts/vastai_start.sh /usr/local/bin/kimodo-vastai-start
COPY scripts/vastai_onstart.sh /workspace/onstart.sh
RUN chmod +x /usr/local/bin/docker-entrypoint \
    /usr/local/bin/kimodo-vastai-start \
    /workspace/onstart.sh

EXPOSE 7860 9550

ENTRYPOINT ["docker-entrypoint"]
CMD ["kimodo-vastai-start"]
